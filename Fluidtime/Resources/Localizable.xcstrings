{
  "sourceLanguage": "en",
  "strings": {
    "alpha.menuBarText": {
      "extractionState": "manual",
      "comment": "Alpha build status item. Preserve the Greek alpha marker. The parameter is the localized duration, or an empty string for icon-only display modes.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "α %@"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "α %@"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "α %@"
          }
        }
      }
    },
    "alpha.menuBarAccessibility": {
      "extractionState": "manual",
      "comment": "Accessibility label identifying the separate Alpha build. The parameter is the existing localized timer or totals status announcement.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fluidtime Alpha: %@"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Fluidtime Alpha: %@"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Fluidtime Alpha: %@"
          }
        }
      }
    },
    "alpha.title": {
      "extractionState": "manual",
      "comment": "Name of the separate build for fictional data. Keep the Fluidtime product name and Alpha build label.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fluidtime Alpha"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Fluidtime Alpha"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Fluidtime Alpha"
          }
        }
      }
    },
    "alpha.connectionOnly": {
      "extractionState": "manual",
      "comment": "Error in the Alpha mock backend when an address other than the fictional server is entered. Preserve the example URL.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Alpha build only uses https://example.invalid. Real accounts are unavailable in this build."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sestavení Alpha používá jen https://example.invalid. Skutečné účty v něm nejsou dostupné."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zostava Alpha používa iba https://example.invalid. Skutočné účty v nej nie sú dostupné."
          }
        }
      }
    },
    "updates.openReleases": {
      "comment": "Opens the Fluidtime GitHub Releases page in the default browser for manual downloads. GitHub is a product name; Releases is the named section of its website. This does not start an in-app update.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open GitHub Releases"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevřít vydání na GitHubu"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvoriť vydania na GitHube"
          }
        }
      }
    },
    "window.actions": {
      "comment": "Tooltip and accessibility label for the compact main window toolbar actions menu.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Actions"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Akce"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Akcie"
          }
        }
      }
    },
    "info.about": {
      "comment": "Tooltip and accessibility label for an information button. The parameter is the metric or control title.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About %@"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "O položce %@"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "O položke %@"
          }
        }
      }
    },
    "analytics.workHelp": {
      "comment": "Explains merged tracked work without subtracting inferred lunch again.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Work time totals your tracked entries. Overlapping time counts once. Gaps, including lunch, aren't included."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpracovaný čas je součtem zaznamenané práce. Překrývající se čas se počítá jen jednou. Mezery včetně oběda se nezapočítávají."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpracovaný čas je súčtom zaznamenanej práce. Prekrývajúci sa čas sa počíta iba raz. Medzery vrátane obeda sa nezapočítavajú."
          }
        }
      }
    },
    "analytics.gapsHelp": {
      "comment": "Explains the remaining gaps within daily attendance spans.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Other gaps are time between entries outside the estimated lunch gap. They don't count as work time."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostatní mezery jsou čas mezi záznamy mimo odhadovanou přestávku na oběd. Do odpracovaného času se nezapočítávají."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostatné medzery sú čas medzi záznamami mimo odhadovanej prestávky na obed. Do odpracovaného času sa nezapočítavajú."
          }
        }
      }
    },
    "workspace.navigation": {
      "comment": "Accessibility label for workspace navigation. View is a noun meaning a destination in the main window.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "View"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazení"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazenie"
          }
        }
      }
    },
    "menuBar.projectColor": {
      "comment": "Menu bar setting. When enabled, the active timer dot uses its project color. The standard dot is used when the color is unavailable.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use project color for the active dot"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Použít barvu projektu pro bod aktivního časovače"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Použiť farbu projektu pre bod aktívneho časovača"
          }
        }
      }
    },
    "analytics.previousMonthToDate": {
      "comment": "Work during the same elapsed portion of the previous month, shown when This month is selected.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Same period last month"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stejné období minulého měsíce"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Rovnaké obdobie minulého mesiaca"
          }
        }
      }
    },
    "menuBar.website": {
      "comment": "Menu bar panel link that opens the configured Solidtime instance in the default browser.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Solidtime website"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Web Solidtime"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Web Solidtime"
          }
        }
      }
    },
    "menuBar.quit": {
      "comment": "Compact menu bar panel button that quits Fluidtime without stopping the server timer.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quit"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukončit"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukončiť"
          }
        }
      }
    },
    "projects.manage": {
      "comment": "Opens the searchable project visibility sheet in Tracking settings.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose visible projects"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vybrat viditelné projekty"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vybrať viditeľné projekty"
          }
        }
      }
    },
    "projects.done": {
      "comment": "Closes the project visibility sheet. Changes are saved immediately.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hotovo"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Hotovo"
          }
        }
      }
    },
    "earnings.enabled": {
      "comment": "Switch in Earnings settings. Off by default; hides private earnings and rate controls when disabled.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable earnings"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapnout výdělky"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapnúť zárobky"
          }
        }
      }
    },
    "earnings.enabledHelp": {
      "comment": "Explanation of the optional private earnings feature.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show a private earnings estimate in Overview. Touch ID is required to view earnings or edit your hourly rate."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazí soukromý odhad výdělku v přehledu. Pro zobrazení výdělku nebo úpravu hodinové sazby je potřeba Touch ID."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazí súkromný odhad zárobku v prehľade. Na zobrazenie zárobku alebo úpravu hodinovej sadzby je potrebné Touch ID."
          }
        }
      }
    },
    "projects.selectAll": {
      "comment": "Button in Visible projects settings. Applies to project picker choices in the selected organization only. Includes every available project, even when search hides some rows.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select all projects"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vybrat všechny projekty"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vybrať všetky projekty"
          }
        }
      }
    },
    "projects.deselectAll": {
      "comment": "Button in Visible projects settings. Applies to project picker choices in the selected organization only. Includes every available project, even when search hides some rows.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deselect all projects"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zrušit výběr všech projektů"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zrušiť výber všetkých projektov"
          }
        }
      }
    },
    "projects.visibilityTitle": {
      "comment": "Heading for project selection preferences in Tracking settings.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Visible projects"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Viditelné projekty"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Viditeľné projekty"
          }
        }
      }
    },
    "projects.visibilityHelp": {
      "comment": "Explains local project picker preferences; this never archives projects or filters history.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose which projects appear when you start or edit a time entry"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte projekty, které se zobrazí při zahájení nebo úpravě časového záznamu"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte projekty, ktoré sa zobrazia pri začatí alebo úprave časového záznamu"
          }
        }
      }
    },
    "projects.visibilityEmpty": {
      "comment": "Empty state for the list of non-archived projects that can be selected for time entries.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No projects are available in this organization"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V této organizaci nejsou k dispozici žádné projekty"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "V tejto organizácii nie sú k dispozícii žiadne projekty"
          }
        }
      }
    },
    "API key": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "API key"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klíč API"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kľúč API"
          }
        }
      },
      "comment": "Account settings field label. API means application programming interface; Solidtime calls its user-created access credential an API key."
    },
    "Account": {
      "extractionState": "manual",
      "comment": "Settings tab for the Solidtime instance and API key.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Účet"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Účet"
          }
        }
      }
    },
    "Active indicator": {
      "extractionState": "manual",
      "comment": "Menu bar display option: a clock with a dot only while a timer is running. The displayed value describes the dot rather than a duration.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Timer status dot"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bod stavu časovače"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bod stavu časovača"
          }
        }
      }
    },
    "Cancel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zrušit"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zrušiť"
          }
        }
      }
    },
    "Choose an available project before saving": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose an available project before saving"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Před uložením vyberte dostupný projekt"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pred uložením vyberte dostupný projekt"
          }
        }
      }
    },
    "Clock only": {
      "extractionState": "manual",
      "comment": "Menu bar display option showing the clock icon without a duration. A dot is added while a timer is running.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clock only"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pouze hodiny"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Iba hodiny"
          }
        }
      }
    },
    "Connect": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Připojit"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pripojiť"
          }
        }
      }
    },
    "Connect to Solidtime": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect to Solidtime"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Připojit k Solidtime"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pripojiť k Solidtime"
          }
        }
      }
    },
    "Connect your Solidtime account to track time from the menu bar": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect your Solidtime account to track time from the menu bar"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Připojte účet Solidtime a sledujte čas z řádku nabídek"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pripojte účet Solidtime a sledujte čas z lišty"
          }
        }
      }
    },
    "Connect your account in the Account tab to choose an organization": {
      "extractionState": "manual",
      "comment": "Empty state in Tracking settings when disconnected.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect your account in the Account tab to choose an organization"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nejprve připojte účet na panelu Účet a pak vyberte organizaci"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Najprv pripojte účet na paneli Účet a potom vyberte organizáciu"
          }
        }
      }
    },
    "Connected as %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connected as %@"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Připojený účet: %@"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pripojený účet: %@"
          }
        }
      },
      "comment": "Connection status in Account settings. The placeholder is the user's display name; preserve user-provided text verbatim."
    },
    "Couldn't load all time entries. Refresh to try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't load all your time entries. Refresh and try again."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepodařilo se načíst všechny časové záznamy. Obnovte je a zkuste to znovu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepodarilo sa načítať všetky časové záznamy. Obnovte ich a skúste to znova."
          }
        }
      },
      "comment": "An incomplete response prevented loading all entries. Existing data is retained; Refresh entries performs another read."
    },
    "Couldn't read the response from Solidtime": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't read the Solidtime data. Refresh and try again."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepodařilo se přečíst data ze Solidtime. Obnovte je a zkuste to znovu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepodarilo sa prečítať údaje zo Solidtime. Obnovte ich a skúste to znova."
          }
        }
      },
      "comment": "The response could not be read. Refresh entries lets the user check the latest server state before trying an action again."
    },
    "Couldn't read your API key from Keychain. Enter it again in Settings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't access your saved API key. Enter it again in Account settings."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepodařilo se získat uložený klíč API. Zadejte ho znovu v nastavení účtu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepodarilo sa získať uložený kľúč API. Zadajte ho znova v nastaveniach účtu."
          }
        }
      },
