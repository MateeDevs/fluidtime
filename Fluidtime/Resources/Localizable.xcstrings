    "entry.deleteHelp": {
      "extractionState": "manual",
      "comment": "Confirmation before permanent deletion of a completed Solidtime entry. Deletion removes the entry and its duration from totals. No undo is available.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleting this entry removes its tracked time from your totals. You can't undo this deletion."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Smazáním záznamu odeberete jeho odpracovaný čas ze součtů. Smazání nelze vrátit zpět."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vymazaním záznamu odoberiete jeho odpracovaný čas zo súčtov. Vymazanie sa nedá vrátiť späť."
          }
        }
      }
    },
    "entry.deleteRunningHelp": {
      "extractionState": "manual",
      "comment": "Confirmation before permanent deletion of a running entry. Stopping a timer retains its tracked time, while deleting removes it. Cancel refers to the confirmation action; stop refers to the timer control.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleting this running entry removes its tracked time. To keep that time, cancel and stop the timer instead. You can't undo this deletion."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Smazáním běžícího záznamu odeberete jeho odpracovaný čas. Pokud chcete čas zachovat, zrušte tuto akci a časovač zastavte. Smazání nelze vrátit zpět."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vymazaním bežiaceho záznamu odoberiete jeho odpracovaný čas. Ak chcete čas zachovať, zrušte túto akciu a časovač zastavte. Vymazanie sa nedá vrátiť späť."
          }
        }
      }
    },
    "entry.deleteChanged": {
