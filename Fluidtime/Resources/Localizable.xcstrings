    "earnings.settingsPrivacyHelp": {
      "extractionState": "manual",
      "comment": "Hidden hourly-rate settings help. No numeric rate or earnings are displayed before successful Touch ID verification.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Touch ID to view or change your hourly rate. Your rate stays in Keychain on this Mac."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomocí Touch ID můžete zobrazit nebo změnit hodinovou sazbu. Sazba zůstává v Klíčence na tomto Macu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomocou Touch ID môžete zobraziť alebo zmeniť hodinovú sadzbu. Sadzba zostáva v Kľúčenke na tomto Macu."
          }
        }
      }
    },
    "earnings.fixedRateHelp": {
      "extractionState": "manual",
      "comment": "One fixed hourly rate only; there is no date-effective history. Preview values are approximate and do not represent payroll.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This rate applies to every period in the preview. Save your changes to keep them. Hiding the rate discards unsaved changes."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tato sazba platí pro všechna období v náhledu. Změny zachováte uložením. Skrytím sazby zahodíte neuložené změny."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Táto sadzba platí pre všetky obdobia v náhľade. Zmeny zachováte uložením. Skrytím sadzby zahodíte neuložené zmeny."
          }
        }
      }
    },
    "earnings.saveRate": {
      "extractionState": "manual",
      "comment": "Stores the single preview hourly rate and currency in local Keychain after the user has authenticated with Touch ID.",
      "localizations": {
