          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Časovač beží v inej organizácii. Na úpravu záznamu vyberte túto organizáciu v nastaveniach sledovania času."
          }
        }
      },
      "comment": "The running timer belongs to another organization. Tracking settings means the Tracking tab of Fluidtime Settings, which contains the organization picker. The panel still offers Stop timer."
    },
    "Your work time in the selected organization, including your running timer. Uses your Solidtime time zone and week start.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
