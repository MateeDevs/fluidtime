    "entry.delete": {
      "extractionState": "manual",
      "comment": "Destructive action permanently removing a time entry from Solidtime.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete entry"
          }
        }
      }
    },
    "entry.deleteHelp": {
      "extractionState": "manual",
      "comment": "Confirmation before deleting a completed time entry.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This permanently deletes the tracked work and removes it from your totals. This cannot be undone."
          }
        }
      }
    },
    "entry.deleteRunningHelp": {
      "extractionState": "manual",
      "comment": "Confirmation before deleting a running entry. Deletion is distinct from stopping and retaining the entry.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This permanently deletes the running entry and its tracked time. To keep the tracked time, cancel and use Stop instead. This cannot be undone."
          }
        }
      }
    },
    "entry.deleteChanged": {
      "extractionState": "manual",
      "comment": "Deletion is blocked after the active timer check detects a changed running state.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This entry’s running state changed on Solidtime. Refresh before deleting it."
          }
        }
      }
    }
