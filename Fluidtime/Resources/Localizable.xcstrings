        }
      },
      "comment": "Generic server error. Describe an unsuccessful user action without referring to HTTP requests."
    },
    "Solidtime couldn't save this entry. Refresh and check your timer and project.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't save the entry. Refresh, then check your timer and project."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Záznam se nepodařilo uložit. Obnovte záznamy a zkontrolujte časovač a projekt."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Záznam sa nepodarilo uložiť. Obnovte záznamy a skontrolujte časovač a projekt."
          }
        }
      },
      "comment": "An entry write failed validation or conflicted with server state. Refresh before checking the timer and project; no write is retried automatically."
    },
    "Solidtime didn't return the number of time entries": {
      "extractionState": "manual",
      "localizations": {
