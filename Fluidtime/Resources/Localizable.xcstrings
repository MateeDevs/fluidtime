    "earnings.saveFailed": {
      "extractionState": "manual",
      "comment": "Local Keychain save failed. The authenticated editor keeps the draft while it remains visible. Hiding the rate or closing settings discards unsaved changes.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't save your hourly rate. Try saving again before hiding the rate or closing settings."
          }
