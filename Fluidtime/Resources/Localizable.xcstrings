    "analytics.lunchTime": {
      "extractionState": "manual",
      "comment": "Statistical unpaid lunch duration: the full longest completed gap between work entries whose midpoint is within the configured lunch window. No timer entry is created.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimated lunch"
          }
        }
      }
    },
    "analytics.averageLunch": {
      "extractionState": "manual",
      "comment": "Estimated lunch duration averaged over the selected day basis, including zero-lunch days in that basis. Lunch is a gap, not a recorded timer type.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Average daily lunch"
          }
        }
      }
    },
    "analytics.lunchHelp": {
      "extractionState": "manual",
      "comment": "Explains how unpaid lunch is inferred from existing work entries without writing entries. The complete qualifying gap is counted, not only the portion within the configured window.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lunch is the longest gap between work entries whose midpoint falls in your lunch hours. It appears after work resumes. Change lunch hours in Workspace settings."
          }
        }
      }
    },
    "lunch.title": {
      "extractionState": "manual",
      "comment": "Workspace settings section for the time window used to infer an unpaid lunch gap between work timers.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lunch estimate"
          }
        }
      }
    },
    "lunch.start": {
      "extractionState": "manual",
      "comment": "Local time at which a gap midpoint first qualifies for the lunch estimate; inclusive.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lunch window starts"
          }
        }
      }
    },
    "lunch.end": {
      "extractionState": "manual",
      "comment": "Local time at which a gap midpoint no longer qualifies for the lunch estimate; exclusive.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lunch window ends"
          }
        }
      }
    },
    "lunch.help": {
      "extractionState": "manual",
      "comment": "The default window is 11:00–15:00. One fully bounded gap per local day is inferred as lunch; other gaps stay separate. This setting never changes tracked work or pay.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses your Solidtime time zone. Counts the full longest gap between work entries whose midpoint falls within these hours. No time entry is created."
          }
        }
      }
    },
    "export.lunchSeconds": {
      "extractionState": "manual",
      "comment": "Daily summary CSV heading for lunch inferred from gaps between tracked entries.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimated lunch in seconds"
          }
        }
      }
    },
    "earnings.settingsPrivacyHelp": {
      "extractionState": "manual",
      "comment": "Hidden hourly-rate settings help. No numeric rate or earnings are displayed before successful Touch ID verification.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Touch ID to view or change your hourly rate. Your rate stays in Keychain on this Mac."
          }
        }
      }
    },
    "earnings.fixedRateHelp": {
      "extractionState": "manual",
      "comment": "One fixed hourly rate only; there is no date-effective history. Preview values are approximate and do not represent payroll.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This rate applies to every period in the preview. Save your changes to keep them. Hiding the rate discards unsaved changes."
          }
        }
      }
    },
    "earnings.saveRate": {
      "extractionState": "manual",
      "comment": "Stores the single preview hourly rate and currency in local Keychain after the user has authenticated with Touch ID.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save hourly rate"
          }
        }
      }
    },
    "earnings.touchIdReason": {
      "extractionState": "manual",
      "comment": "Localized reason in the native macOS Touch ID prompt. This is an explanation of why authentication is needed, not an instruction to touch the sensor.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show your hourly rate or earnings preview"
          }
        }
      }
    },
    "earnings.touchIdUnavailable": {
      "extractionState": "manual",
      "comment": "Biometric-only access is required. Also used when Touch ID is locked out, unavailable on the hardware, or not enrolled. Do not imply password fallback is available.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch ID is unavailable. Set up Touch ID in System Settings to view private values."
          }
        }
      }
    },
    "earnings.touchIdFailed": {
      "extractionState": "manual",
      "comment": "Biometric verification failed. The rate and preview stay hidden.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t verify with Touch ID. Try again to view private values."
          }
        }
      }
    },
    "earnings.unlocking": {
      "extractionState": "manual",
      "comment": "Accessibility label for the delayed progress indicator while Touch ID and a private Keychain read complete.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifying private access"
          }
        }
      }
    },
    "earnings.connectFirst": {
      "extractionState": "manual",
      "comment": "The local preview rate is scoped to the Solidtime instance, user, and organization.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect to Solidtime and choose an organization to set your hourly rate"
          }
        }
      }
    },
    "earnings.changeInSettings": {
      "extractionState": "manual",
      "comment": "Help in the read-only preview. The rate can only be configured in the Settings window.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change your hourly rate in Earnings settings"
          }
        }
      }
    },
    "earnings.touchIdLocked": {
      "extractionState": "manual",
      "comment": "Touch ID has been locked after failed attempts. Unlocking macOS reenables biometric checks; Fluidtime still requires a separate successful Touch ID check and does not offer password fallback.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch ID is locked. Unlock your Mac with your password, then try Touch ID again."
          }
        }
      }
    },
    "feedback.announcement": {
      "extractionState": "manual",
      "comment": "VoiceOver announcement for the compact timer feedback pill. First argument: localized status title. Second argument: full task description, duration, or guidance. Preserve both arguments even when the visible pill truncates text.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. %2$@"
          }
        }
      }
    },
