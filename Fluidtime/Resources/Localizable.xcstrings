      }
    },
    "lunch.help": {
      "extractionState": "manual",
      "comment": "Default window is 11:00–15:00 in the Solidtime account time zone. At most one fully bounded same-day gap is estimated as lunch; other gaps remain separate. Window start is inclusive and end is exclusive. Changing the window never changes tracked work or earnings.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The lunch estimate uses your Solidtime time zone and the full length of the longest gap whose midpoint falls within these hours. Changing this window doesn't change your work totals or earnings preview."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odhad oběda používá časové pásmo ze Solidtime a celou délku nejdelší mezery, jejíž střed spadá do těchto hodin. Změna tohoto rozmezí neovlivní odpracovaný čas ani odhad výdělku."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odhad obeda používa časové pásmo zo Solidtime a celú dĺžku najdlhšej medzery, ktorej stred spadá do týchto hodín. Zmena tohto rozmedzia neovplyvní odpracovaný čas ani odhad zárobku."
          }
        }
      }
    },
