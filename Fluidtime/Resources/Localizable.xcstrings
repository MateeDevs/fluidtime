    "feedback.reminderIdle": {
      "extractionState": "manual",
      "comment": "Compact idle-reminder subtitle beneath a title explaining that the timer is still running.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review your timer"
          }
        }
      }
    },
    "feedback.reminderLong": {
      "extractionState": "manual",
      "comment": "Compact long-running reminder subtitle beneath a title explaining that the timer is still running.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review your timer"
          }
