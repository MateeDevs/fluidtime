    "Elapsed time %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Elapsed time %@"
          }
        }
      },
      "comment": "Accessibility label for the active timer duration. The placeholder is elapsed hours:minutes:seconds, not a time of day."
    },
    "Enter a valid instance address": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a valid Solidtime address"
          }
        }
      },
      "comment": "Validation error for an invalid Solidtime web address. The address field is in the Account tab of Settings."
    },
    "Enter a valid instance address, such as https://app.solidtime.io": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a valid Solidtime address, such as https://app.solidtime.io"
          }
        }
      },
      "comment": "Validation error for an invalid Solidtime address. Keep the example URL unchanged."
    },
    "Enter your API key": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter your API key"
          }
        }
      },
      "comment": "Placeholder and validation message for the required API key field. API is the standard Solidtime credential term."
    },
    "Fluidtime": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
