    "earnings.billableHelp": {
      "extractionState": "manual",
      "comment": "Billable is a Solidtime entry flag for client billing. It does not establish that a client has been charged or determine employee pay. The filter is off by default.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Billable work is marked for client billing. Leave this filter off to include all your work time."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Fakturovatelná práce je označená pro účtování klientovi. Pro zahrnutí veškeré práce nechte tento filtr vypnutý."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Fakturovateľná práca je označená na účtovanie klientovi. Na zahrnutie všetkej práce nechajte tento filter vypnutý."
          }
        }
      }
    },
    "earnings.estimate": {
      "extractionState": "manual",
      "comment": "Approximate preview using one current hourly rate and tracked work in the selected period. No historical rate, payroll, or pay eligibility rules are applied.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimated earnings"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odhad výdělku"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odhad zárobku"
          }
        }
      }
    },
    "earnings.estimateHelp": {
      "extractionState": "manual",
      "comment": "An approximate preview using the current fixed rate for the entire selected period. No historical rates or payroll rules. Inferred lunch is not deducted a second time.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The preview uses your current hourly rate for the selected work time. Gaps, including lunch, aren't included. The estimate doesn't include taxes or deductions."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Náhled používá aktuální hodinovou sazbu pro vybraný odpracovaný čas. Mezery včetně oběda se nezapočítávají. Odhad nezahrnuje daně ani srážky."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Náhľad používa aktuálnu hodinovú sadzbu pre vybraný odpracovaný čas. Medzery vrátane obeda sa nezapočítavajú. Odhad nezahŕňa dane ani zrážky."
          }
        }
      }
    },
