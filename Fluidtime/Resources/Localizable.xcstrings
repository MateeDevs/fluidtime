    "Join an organization on your instance webpage to start tracking time": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create or join an organization on Solidtime to start tracking time"
          }
        }
      },
      "comment": "Shown when the connected account has no organization memberships. Creating or joining an organization happens on the Solidtime website."
    },
    "Keep the description under 5,000 characters": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use 5,000 characters or fewer"
          }
        }
      },
      "comment": "Validation error when an entry description exceeds 5,000 characters. Exactly 5,000 characters are allowed."
    },
