    "Your running timer changed on Solidtime. Refresh before stopping it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your running timer changed on Solidtime. Refresh your entries before stopping it."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Běžící časovač se v Solidtime změnil. Před zastavením obnovte záznamy."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bežiaci časovač sa v Solidtime zmenil. Pred zastavením obnovte záznamy."
          }
        }
      },
      "comment": "The server timer differs from the local timer. No stop is sent. Refresh entries updates the panel before the user tries again."
    },
    "Your timer is running in another organization. Stop it here, or select its organization to edit it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your timer is running in another organization. Choose that organization in Tracking settings to edit the entry."
          }
        },
