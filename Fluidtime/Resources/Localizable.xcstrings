          }
        }
      }
    },
    "analytics.averageLunch": {
      "extractionState": "manual",
      "comment": "Estimated lunch duration averaged over the selected day basis, including zero-lunch days in that basis. Lunch is a gap, not a recorded timer type.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Average daily lunch"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Průměrná denní doba oběda"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Priemerný denný čas obeda"
          }
        }
      }
    },
    "analytics.lunchHelp": {
      "extractionState": "manual",
      "comment": "Lunch is inferred from gaps between tracked entries, not recorded as an entry. Count the whole qualifying gap, not just its overlap with the lunch window. On equal durations, the first gap is used.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lunch is estimated from the longest gap between entries each day. The gap's midpoint must fall within your lunch window, and work must resume afterward. Change the window in Workspace settings."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Oběd se odhaduje z nejdelší mezery mezi záznamy v daném dni. Střed mezery musí spadat do nastavené doby oběda a práce poté musí pokračovat. Dobu oběda změníte v nastavení pracovního prostředí."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Obed sa odhaduje z najdlhšej medzery medzi záznamami v danom dni. Stred medzery musí spadať do nastaveného času obeda a práca potom musí pokračovať. Čas obeda zmeníte v nastaveniach pracovného prostredia."
          }
        }
      }
    },
    "lunch.title": {
      "extractionState": "manual",
      "comment": "Workspace settings section for the time window used to estimate lunch from gaps between tracked entries. No paid or unpaid status is inferred.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lunch estimate"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odhad oběda"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odhad obeda"
          }
        }
      }
    },
    "lunch.start": {
      "extractionState": "manual",
      "comment": "Local time at which a gap midpoint first qualifies for the lunch estimate; inclusive.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lunch window starts"
