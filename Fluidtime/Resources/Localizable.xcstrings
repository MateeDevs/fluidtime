{
  "sourceLanguage": "en",
  "strings": {
    "updates.openReleases": {
      "comment": "Opens the project GitHub releases page in the default browser for manual updates. Does not start Sparkle.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open GitHub releases"
          }
        }
      }
    },
    "window.actions": {
      "comment": "Tooltip and accessibility label for the compact main window toolbar actions menu.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Actions"
          }
        }
      }
    },
    "info.about": {
      "comment": "Tooltip and accessibility label for an information button. The parameter is the metric or control title.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About %@"
          }
        }
      }
    },
    "analytics.workHelp": {
      "comment": "Explains merged tracked work without subtracting inferred lunch again.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Work time adds your tracked intervals. Overlapping entries count only once. Lunch and other gaps are not included."
          }
        }
      }
    },
    "analytics.gapsHelp": {
      "comment": "Explains the remaining gaps within daily attendance spans.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Other gaps are time between tracked entries, excluding the estimated lunch gap. They do not count as tracked work."
          }
        }
      }
    },
    "workspace.navigation": {
      "comment": "Accessibility label for the main window toolbar view switcher.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "View"
          }
        }
      }
    },
    "menuBar.projectColor": {
      "comment": "Menu bar setting. When enabled, the active timer dot uses its project color. The standard dot is used when the color is unavailable.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use project color for the active dot"
          }
        }
      }
    },
    "analytics.previousMonthToDate": {
      "comment": "Work during the same elapsed portion of the previous month, shown when This month is selected.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Previous month to date"
          }
        }
      }
    },
    "menuBar.website": {
      "comment": "Menu bar panel link that opens the configured Solidtime instance in the default browser.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Solidtime website"
          }
        }
      }
    },
    "menuBar.quit": {
      "comment": "Compact menu bar panel button that quits Fluidtime without stopping the server timer.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quit"
          }
        }
      }
    },
    "projects.manage": {
      "comment": "Opens the searchable project visibility sheet in Tracking settings.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose visible projects…"
          }
        }
      }
    },
    "projects.done": {
      "comment": "Closes the project visibility sheet. Changes are saved immediately.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done"
          }
        }
      }
    },
    "earnings.enabled": {
      "comment": "Switch in Earnings settings. Off by default; hides private earnings and rate controls when disabled.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable earnings"
          }
        }
      }
    },
    "earnings.enabledHelp": {
      "comment": "Explanation of the optional private earnings feature.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show a private earnings estimate in Overview. Touch ID is required to view earnings or edit your hourly rate."
          }
        }
      }
    },
    "projects.selectAll": {
      "comment": "Button in Visible projects settings. Applies to project picker choices in the selected organization only. Includes every available project, even when search hides some rows.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select all projects"
          }
        }
      }
    },
    "projects.deselectAll": {
      "comment": "Button in Visible projects settings. Applies to project picker choices in the selected organization only. Includes every available project, even when search hides some rows.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deselect all projects"
          }
        }
      }
    },
    "projects.visibilityTitle": {
      "comment": "Heading for project selection preferences in Tracking settings.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Visible projects"
          }
        }
      }
    },
    "projects.visibilityHelp": {
      "comment": "Explains local project picker preferences; this never archives projects or filters history.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose which projects appear when you start or edit a timer."
          }
        }
      }
    },
    "projects.visibilityEmpty": {
      "comment": "Empty state for the list of non-archived projects that can be selected for time entries.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No projects are available in this organization."
          }
        }
      }
    },
    "API key": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "API key"
          }
        }
      },
      "comment": "Account settings field label. API means application programming interface; Solidtime calls its user-created access credential an API key."
    },
    "Account": {
      "extractionState": "manual",
      "comment": "Settings tab for the Solidtime instance and API key.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account"
          }
        }
      }
    },
    "Active indicator": {
      "extractionState": "manual",
      "comment": "Menu bar display option: a clock with a dot only while a timer is running. The displayed value describes the dot rather than a duration.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Timer status dot"
          }
        }
      }
    },
    "Cancel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        }
      }
    },
    "Choose an available project before saving": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose an available project before saving"
          }
        }
      }
    },
    "Clock only": {
      "extractionState": "manual",
      "comment": "Menu bar display option showing only the clock icon.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clock only"
          }
        }
      }
    },
    "Connect": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect"
          }
        }
      }
    },
    "Connect to Solidtime": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect to Solidtime"
          }
        }
      }
    },
    "Connect your Solidtime account to track time from the menu bar": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect your Solidtime account to track time from the menu bar"
          }
        }
      }
    },
    "Connect your account in the Account tab to choose an organization": {
      "extractionState": "manual",
      "comment": "Empty state in Tracking settings when disconnected.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect your account in the Account tab to choose an organization"
          }
        }
      }
    },
    "Connected as %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connected as %@"
          }
        }
      },
      "comment": "Connection status in Account settings. The placeholder is the user's display name; preserve user-provided text verbatim."
    },
    "Couldn't load all time entries. Refresh to try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't load all your time entries. Refresh and try again."
          }
        }
      },
      "comment": "An incomplete response prevented loading all entries. Existing data is retained; Refresh entries performs another read."
    },
    "Couldn't read the response from Solidtime": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't read the Solidtime data. Refresh and try again."
          }
        }
      },
      "comment": "The response could not be read. Refresh entries lets the user check the latest server state before trying an action again."
    },
    "Couldn't read your API key from Keychain. Enter it again in Settings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't access your saved API key. Enter it again in Account settings."
          }
        }
      },
      "comment": "The saved credential could not be accessed. The user can enter the API key again in the Account tab of Settings."
    },
    "Couldn't remove your API key from Keychain": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't remove your saved API key. Try disconnecting again."
          }
        }
      },
      "comment": "Disconnecting could not remove the saved local credential. The account remains connected so the user can retry Disconnect."
    },
    "Couldn't save your API key in Keychain": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't save your API key on this Mac. Try connecting again."
          }
        }
      },
      "comment": "The API key could not be saved locally during connection. Connecting again retries credential storage."
    },
    "Couldn't update your API key in Keychain": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't update your saved API key. Try connecting again."
          }
        }
      },
      "comment": "The replacement API key could not be saved locally. Connecting again retries credential storage."
    },
    "Create an API key in your Solidtime account settings. Your key is stored securely in Keychain.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create an API key in your Solidtime account settings. Fluidtime stores it in Keychain on this Mac."
          }
        }
      },
      "comment": "Account settings help. API means application programming interface. Solidtime is the service name. Keychain is the macOS credential store; use the platform's localized term for it."
    },
    "Description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Description"
          }
        }
      }
    },
    "Disconnect": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnect"
          }
        }
      }
    },
    "Disconnect from Solidtime?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnect from Solidtime?"
          }
        }
      }
    },
    "Display": {
      "extractionState": "manual",
      "comment": "Label for the kind of information shown in the macOS menu bar.",
      "localizations": {
        "en": {
