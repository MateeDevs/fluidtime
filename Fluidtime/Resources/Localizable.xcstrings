          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uložený klíč API bude z tohoto Macu odstraněn. Běžící časovač bude v Solidtime pokračovat."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Uložený kľúč API bude z tohto Macu odstránený. Bežiaci časovač bude v Solidtime pokračovať."
          }
        }
      },
      "comment": "Disconnect confirmation body. Only the local saved credential is removed; a server-side running timer continues."
    },
