    },
    "earnings.touchIdReason": {
      "extractionState": "manual",
      "comment": "Localized reason in the native macOS Touch ID prompt. This is an explanation of why authentication is needed, not an instruction to touch the sensor.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show your hourly rate or earnings preview"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazení hodinové sazby nebo odhadu výdělku"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazenie hodinovej sadzby alebo odhadu zárobku"
          }
        }
      }
    },
    "earnings.touchIdUnavailable": {
      "extractionState": "manual",
      "comment": "Touch ID is an Apple biometric feature; use its official localized product name. Shown when hardware is unavailable or Touch ID is not enrolled. Hardware may not support Touch ID, so setup is not guaranteed to resolve this. No password or Apple Watch fallback is offered.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch ID is required to view your hourly rate and earnings. Check Touch ID in System Settings."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro zobrazení hodinové sazby a výdělků je potřeba Touch ID. Zkontrolujte Touch ID v Nastavení systému."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Na zobrazenie hodinovej sadzby a zárobkov je potrebné Touch ID. Skontrolujte Touch ID v Systémových nastaveniach."
          }
        }
      }
    },
    "earnings.touchIdFailed": {
      "extractionState": "manual",
      "comment": "Biometric verification failed. The rate and preview stay hidden.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't verify with Touch ID. Try again to view your hourly rate or earnings."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ověření přes Touch ID se nepodařilo. Zkuste znovu zobrazit hodinovou sazbu nebo výdělky."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Overenie cez Touch ID sa nepodarilo. Skúste znova zobraziť hodinovú sadzbu alebo zárobky."
          }
        }
      }
    },
    "earnings.unlocking": {
