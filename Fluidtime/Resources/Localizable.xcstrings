    "Solidtime couldn't complete the request. Try again in a moment.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Solidtime couldn't complete this action. Try again in a moment."
          }
