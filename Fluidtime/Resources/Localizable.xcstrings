            "value": "Billable controls client billing, not your hourly pay"
          }
        }
      }
    },
    "editor.invalidDates": {
      "extractionState": "manual",
      "comment": "Date validation; a running entry has no end but its start cannot be in the future.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a start before the end and keep both times in the past"
          }
        }
      }
    },
    "editor.timerChanged": {
      "extractionState": "manual",
      "comment": "Refuses to edit a running entry after the server’s active entry changed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your running timer changed on Solidtime. Cancel this edit and refresh your entries."
          }
        }
      }
    },
    "updates.title": {
      "extractionState": "manual",
      "comment": "Settings section backed by the Sparkle update framework.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App updates"
          }
        }
      }
    },
    "updates.automaticChecks": {
      "extractionState": "manual",
      "comment": "Sparkle preference; checks the signed update feed associated with GitHub Releases.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check for updates automatically"
          }
        }
      }
    },
    "updates.automaticInstallation": {
      "extractionState": "manual",
      "comment": "Sparkle preference controlling automatic downloading and installation when supported.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download and install updates automatically"
          }
        }
      }
    },
    "updates.checkNow": {
      "extractionState": "manual",
      "comment": "Starts a user-initiated update check using Sparkle’s standard native interface.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check for updates"
          }
        }
      }
    },
    "updates.help": {
      "extractionState": "manual",
      "comment": "Describes the source and signature verification without implying a current update exists.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Updates come from Fluidtime’s GitHub Releases and are verified before installation"
          }
        }
      }
    },
    "updates.unavailable": {
      "extractionState": "manual",
      "comment": "Displayed while in-app updates are intentionally disabled. The settings controls are hidden.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Updates aren’t available yet. Install new versions manually for now."
          }
        }
      }
    },
    "timer.otherOrganization": {
      "extractionState": "manual",
      "comment": "The active timer belongs to another membership; selected-organization statistics exclude it.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Running in another organization"
          }
        }
      }
    },
    "timer.noRecentEntry": {
      "extractionState": "manual",
      "comment": "Shortcut empty state when no completed work entry can supply the default.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create your first work entry in Fluidtime before using the timer shortcut"
          }
        }
      }
    },
    "Fluidtime, timer running, today's total %@": {
      "extractionState": "manual",
      "comment": "Menu bar accessibility label. Placeholder is a duration in hours:minutes[:seconds]. Both the live timer status and daily total must be announced.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fluidtime, timer running, today's total %@"
          }
        }
      }
    },
    "Fluidtime, timer running, this week's total %@": {
      "extractionState": "manual",
      "comment": "Menu bar accessibility label. Placeholder is a duration in hours:minutes[:seconds]. Both live timer status and weekly total must be announced.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fluidtime, timer running, this week's total %@"
          }
        }
      }
    },
    "export.entriesFilename": {
